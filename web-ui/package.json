{
  "name": "kiro-bot-ui",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "video": "remotion studio video/index.ts",
    "video:render": "remotion render video/index.ts ProductDemo out/kiro-bot-demo-remotion.mp4",
    "video:still": "remotion still video/index.ts ProductDemo out/kiro-bot-demo-frame.png --frame=450",
    "demo:preview": "vite preview --port 4173",
    "demo:record": "node demo/record.mjs",
    "demo:film": "npm run build && npm run demo:record"
  },
  "dependencies": {
    "@fontsource-variable/fraunces": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource-variable/source-serif-4": "^5.3.0",
    "@fontsource-variable/space-grotesk": "^5.3.0",
    "@remotion/cli": "^4.0.517",
    "@remotion/media-utils": "^4.0.517",
    "@remotion/player": "^4.0.517",
    "framer-motion": "^11.18.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1",
    "remotion": "^4.0.517"
  },
  "devDependencies": {
    "@types/node": "^26.3.0",
    "@types/react": "^18.3.18",
    "@types/react-dom": "^18.3.5",
    "@vitejs/plugin-react": "^4.3.4",
    "playwright": "^1.52.0",
    "typescript": "^5.7.3",
    "vite": "^6.0.7"
  }
}

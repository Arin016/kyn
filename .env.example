# Local data directory (Fly uses /data on a persistent volume)
KYN_HOME=~/.kyn

# Remote deploy: require Authorization: Bearer <token> on /api and /ws
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
KYN_ACCESS_TOKEN=

# Remote deploy: allow browser UI on another origin (comma-separated)
# Example: https://kyn.vercel.app,https://www.kyn.dev
KYN_ALLOWED_ORIGINS=

# Bind address for kyn serve (Fly sets 0.0.0.0 via Dockerfile CMD)
KYN_HOST=127.0.0.1
PORT=8765

# Vercel build (set in Vercel dashboard, not here)
# VITE_KYN_API_URL=https://your-app.fly.dev
# VITE_KYN_ACCESS_TOKEN=same-as-KYN_ACCESS_TOKEN
